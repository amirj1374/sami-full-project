# Copy to `.env` and adjust. NEVER commit the real `.env`.
# Used by docker-compose.yml (backend standalone stack).

# --- Database ---
POSTGRES_DB=sami
POSTGRES_USER=sami
POSTGRES_PASSWORD=sami

# --- Spring profile: dev (verbose) or prod (quiet) ---
SPRING_PROFILES_ACTIVE=dev

# --- JWT (use a long, random secret; min 32 bytes for HS256) ---
JWT_SECRET=change-me-in-env-a-very-long-dev-only-secret-value-32b+
JWT_ISSUER=sami

# --- CORS (frontend origin) ---
# Dev (Vite): http://localhost:5173. Full-stack prod (behind nginx): http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Full-stack prod only (docker-compose.prod.yml); optional, defaults shown ---
#FRONTEND_PORT=80
#VITE_API_BASE_URL=/api

# --- Bootstrap admin (created on first run if the users table is empty) ---
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@sami.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Auto-generated code formats (optional; defaults shown) ---
#CRM_CODE_PREFIX=C
#CRM_CODE_PADDING=6
#SUP_CODE_PREFIX=SUP-
#SUP_CODE_PADDING=6
#PUR_NUMBER_INCLUDE_YEAR=true
#PUR_NUMBER_PADDING=6
