# Copy this file to .env for an internet-accessible TEST deployment.
# Replace every CHANGE_ME value. Never commit the resulting .env.

POSTGRES_DB=sami
POSTGRES_USER=sami
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

SPRING_PROFILES_ACTIVE=prod

JWT_SECRET=CHANGE_ME_RANDOM_STAFF_SECRET_AT_LEAST_32_CHARACTERS
PORTAL_JWT_SECRET=CHANGE_ME_DIFFERENT_PORTAL_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=sami-test

# Replace SERVER_PUBLIC_IP with the actual address, for example http://203.0.113.10
CORS_ALLOWED_ORIGINS=http://SERVER_PUBLIC_IP

FRONTEND_PORT=80
VITE_API_BASE_URL=/api

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Test Administrator

DEMO_SEED_ENABLED=false
DEMO_HOURLY_NOTIFICATION_ENABLED=false
LICENSING_ENFORCE=false
